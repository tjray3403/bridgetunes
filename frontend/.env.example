# Public API base URL. This value is bundled into the browser app.
VITE_API_URL=http://localhost:8080
VITE_SPOTIFY_CLIENT_ID=
# Must exactly match a Spotify Dashboard redirect URI. Local dev should use 127.0.0.1 for the site too.
VITE_SPOTIFY_REDIRECT_URI=http://127.0.0.1:5173/spotify/callback
VITE_GOOGLE_CLIENT_ID=
