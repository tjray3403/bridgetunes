PORT=8080
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://bridgetunes-fccff.web.app,https://bridgetunes-fccff.firebaseapp.com
RENDER_EXTERNAL_URL=https://YOUR-RENDER-SERVICE.onrender.com

# Firebase Admin service account values. Store actual values only in local .env or Render secrets.
FIREBASE_PROJECT_ID=bridgetunes-fccff
FIREBASE_CLIENT_EMAIL=
# Put the service-account key on one line and represent line breaks as \n.
FIREBASE_PRIVATE_KEY=

# Upstash QStash credentials.
QSTASH_URL=https://qstash.upstash.io
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# Upstash Redis REST credentials (used for playlist/track hot caches and job progress).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Spotify Client Credentials for public playlist reads and catalog searches.
# Keep the Client Secret on the API server only.
ENABLE_SPOTIFY=true
ENABLE_APPLE_MUSIC=true
ENABLE_YOUTUBE_MUSIC=false
YOUTUBE_API_KEY=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
APPLE_DEVELOPER_TOKEN=
