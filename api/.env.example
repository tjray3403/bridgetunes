PORT=8080
FRONTEND_ORIGINS=http://localhost:5173,https://bridgetunes-fccff.web.app,https://bridgetunes-fccff.firebaseapp.com
RENDER_EXTERNAL_URL=https://YOUR-RENDER-SERVICE.onrender.com

# Firebase Admin service account values. Store actual values only in local .env or Render secrets.
FIREBASE_PROJECT_ID=bridgetunes-fccff
FIREBASE_CLIENT_EMAIL=
# Put the service-account key on one line and represent line breaks as \n.
FIREBASE_PRIVATE_KEY=

# Upstash QStash credentials.
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# Provider credentials used by the current import and matching adapters.
SYSTEM_MUSIC_TOKEN=
APPLE_DEVELOPER_TOKEN=
